# Local Development Environment
# Copy this file to .env.local for local development
APP_ENV=local

# Turnstile test key (always passes validation)
# https://developers.cloudflare.com/turnstile/reference/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Used by the browser only during local development. Docker Compose sets this
# automatically; set it when running Next.js outside Docker.
# NEXT_PUBLIC_CONTACT_API_URL=http://localhost:8787/api/contact
# `next dev` proxies /api/study-group/* here so the session cookie stays same-origin.
# STUDY_GROUP_API_PROXY_URL=http://localhost:8788
# STUDY_GROUP_SLUG=local
NEXT_PUBLIC_OG_IMAGE=/images/og/og-image-profile.png
