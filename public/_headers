# Security headers for every response. The CSP allows the static Next.js export (its inline bootstrap scripts), Cloudflare
# Turnstile on /contact, and same-origin calls to the contact and study group APIs; Google sign-in is a top-level
# navigation, which the CSP doesn't restrict.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed Next.js bundles and imported assets — safe to cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Resumes change on deploy — always revalidate
/resume/*
  Cache-Control: public, max-age=0, must-revalidate

# Brand/social images may update without a path change
/images/og/*
  Cache-Control: public, max-age=0, must-revalidate

/images/icons/*
  Cache-Control: public, max-age=0, must-revalidate

/images/avatar.png
  Cache-Control: public, max-age=0, must-revalidate

# Study group app pages (board, settings, join, account, admin) — keep out of search engines and referrers (D2).
# The landing (/study-groups, /pt-br/grupos-de-estudo-de-ingles) and the terms pages stay indexable.
/study-group/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/g/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/group
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/group/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/new
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/my
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/account
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/welcome
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/admin
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
