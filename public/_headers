# Hashed Vite bundles — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Resumes change on deploy — always revalidate
/resume/*
  Cache-Control: public, max-age=0, must-revalidate

# Brand/social images may update without a path change
/images/og/*
  Cache-Control: public, max-age=0, must-revalidate

/images/icons/*
  Cache-Control: public, max-age=0, must-revalidate

/images/avatar.png
  Cache-Control: public, max-age=0, must-revalidate

# Study group app pages (board, settings, join, account, admin) — keep out of search engines and referrers (D2).
# The landing and policy pages under /study-groups and /pt-br/study-groups stay indexable.
/study-group/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/g/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/group
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/group/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/new
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/my
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/account
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/study-groups/welcome
